@{
    ViewData["Title"] = "Home Page";
}

<h1 class="display-4">题库列表</h1>

<br/>
<div id="problemList">
    
</div>


<script type="text/javascript">

    window.onload = function() {

        $.ajax({
            type: 'get',
            url: "http://47.240.2.193:4399/api/Problems",
            xhrFields: {
                withCredentials: true
            },
            crossDomain: true,
            success: function(data) {

                $.each(data,
                    function(i, term) {

                        var html = "<div class='card shadow-sm'>";
                        html += "<div class='card-body'>";
                        html += "<a href='Problems/Detail?problemId="+term.problem.problemId+"'>" + "<font size='5'>"+term.problem.problemId + " . " + term.problem.title + "</font></a>";
                        if (term.status==1) {
                            html += "<ion-icon style='float:right' size='large' name='checkmark'></ion-icon>"; 
                        }
                        else if (html.status == 0) {
                            html += "<ion-icon style='float:right' size='large' name='close'></ion-icon>"; 
                        }
                        html += "</div></div><br />";
                        $("#problemList").append(html);
                    });

            },
            error: function(data) {
                console.log(data);
            }
        });
    }

</script>