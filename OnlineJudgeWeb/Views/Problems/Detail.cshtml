<h1 class="display-4" style="display: inline-block" id="title"></h1> &nbsp;&nbsp;&nbsp;&nbsp;
内存限制：<h6 class="display-8 font-weight-normal" style="display: inline-block" id="memory"></h6> kb &nbsp;&nbsp;&nbsp;&nbsp;
时间限制：<h6 class="display-8 font-weight-normal" style="display: inline-block" id="time"></h6> ms
<br/>

<div class="card w-105 shadow-lg">
    <div class="card-body" style="margin: 15px;">
        <h6 class="card-title">题目描述：</h6>
        <p class="card-text font-weight-light" style="white-space: pre" id="content"></p>
        <br/>
        <h6 class="card-title">样例输入：</h6>
        <p class="card-text font-weight-light" style="white-space: pre" id="exampleInput"></p>
        <br/>
        <h6 class="card-title">样例输出：</h6>
        <p class="card-text font-weight-light" style="white-space: pre" id="exampleOutPut"></p>
    </div>
</div>

<br/>
<br/>

<div class="card w-105 shadow-lg">
    <br/>

    <div class="form-group" style="margin: 15px">
        <div class="col-sm-2">
            <label class="display-5">选择编译器</label>
        </div>
        <div class="col-sm-4">
            <select id="codeType" class="form-control">
                <option value="0">
                    gcc
                </option>
                <option value="1">
                    g++
                </option>
                <option value="2">
                    python
                </option>
            </select>
        </div>
        <br/>
        <div class="col-sm-10">
            <textarea class="form-control" rows="20" id="sourceCode"></textarea>
        </div>
        <br/>
        <div class="col-sm-3">
            <button type="button" onclick="SubmitJudge()" class="btn btn-secondary btn-lg btn-block">
                <a class="display-5">提交</a>
            </button>
        </div>
    </div>
    <br/>
</div>
<br/>
<hr/>
<br/>
<div id="result">

</div>

<script type="text/javascript">

    var editor = CodeMirror.fromTextArea(document.getElementById("sourceCode"), {
        //Java高亮显示
        mode:"text/x-java",
        //mode: "text/x-c++src",
        
        
        //mode: "text/x-python",
        //mode: "text/x-cython",
        //显示行号
        lineNumbers: true,

        //设置主题
        theme: "idea",

        //绑定Vim
        // keyMap:"vim",

        //代码折叠
        lineWrapping: true,
        foldGutter: true,
        gutters: ["CodeMirror-linenumbers", "CodeMirror-foldgutter"],

        //全屏模式
        fullScreen: false,

        //括号匹配
        matchBrackets: true,
        
        matchTags: true,

        autoCloseBrackets: true,
        
        autoCloseTags:true,
        
        showTrailingSpace:true,
        
        showCursorWhenSelecting:true,
        
        //showHint:true,

        //智能提示 
        extraKeys:{"Ctrl-Space":"autocomplete"}//ctrl-space唤起智能提示
    });

    editor.setSize("100%", "500");
    
    $("#codeType").change(function(){
        var opt=$("#codeType").val();
        
        if (opt == 0 || opt == 1) {
            
            update("text/x-c++src");
            
        }
        else if (opt == 2) {
            
            update("text/x-python");
        }
    });
    
    function update(mode) {
        editor.setOption("mode",mode);
    }
   
</script>



<script type="text/javascript">

    var id;

    window.onload = function() {
        
        id = getQueryVariable("problemId");

        $.ajax({
            type: 'get',
            url: url + "/api/Problems/Detail/" + id,
            xhrFields: {
                withCredentials: true
            },
            crossDomain: true,
            success: function(data) {

                $("#title").html(data.title);
                $("#memory").html(data.memoryLimit);
                $("#time").html(data.timeLimit);
                $("#content").html(data.content);
                $("#exampleInput").html(data.exampleInput);
                $("#exampleOutPut").html(data.exampleOutPut);

            },
            error: function(data) {
                console.log(data);
            }
        });
    }

    function SubmitJudge() {

        var userName = getCookie("userName");
        var userId = getCookie("userId");
        if (userName == "") {
            window.location.href = "/Users/create";
        }

        var preHtml = $("#result").html();

        var html = "<div class='alert alert-secondary' id='submitId'>";
        html += "<div class='clearfix'>";
        html += "<strong>Judging...</strong>";
        html += "<div class='spinner-border float-right' role='status'>";
        html += "<span class='sr-only'>Loading...</span>";
        html += "</div></div></div>";

        html += preHtml;

        $("#result").html(html);
        
        var codeType = $("#codeType").val();
        var codeSuffix = "";
        if (codeType == 0 || codeType == 1)
            codeSuffix = "cpp";
        else
            codeSuffix = "py";

        var code = editor.getValue();
        
        var data = {
            ProblemId: id,
            UserId: userId,
            CodeType: codeType,
            CodeSuffix: codeSuffix,
            SourceCode: code
        };

        var memory = $("#memory").html();
        var time = $("#time").html();
        

        $.ajax({
            type: "post",
            url: url + "/api/Judge/submit/" + memory + "/" + time,
            contentType: "application/json; charset=utf-8",
            xhrFields: {
                withCredentials: true
            },
            crossDomain: true,
            data: JSON.stringify(data),
            dataType: "json",
            success: function(data) {

                $("#submitId").empty();


                if (data.judgeStatus == 2) {

                    $("#submitId").attr("class", "alert alert-success");
                } else {
                    $("#submitId").attr("class", "alert alert-danger");
                }

                $("#submitId").html(data.judgeResult);

                $("#submitId").attr("id", "submit" + data.submitId);

            }
        });

    }

    function getQueryVariable(variable) {
        var query = window.location.search.substring(1);
        var vars = query.split("&");
        for (var i = 0; i < vars.length; i++) {
            var pair = vars[i].split("=");
            if (pair[0] == variable) {
                return pair[1];
            }
        }
        return(false);
    }

</script>




