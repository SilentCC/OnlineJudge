@{
    ViewData["Title"] = "Home Page";
}

<h1 class="display-4">计算A+B</h1>
<div class="form-group">
    <div class="col-sm-2">
        <label class="display-5">选择编译器</label>
    </div>
    <div class="col-sm-4">
        <select class="form-control">
            <option>gcc
            </option>
            <option>g++
            </option>
        </select>
    </div>
    <br/>
    <div class="col-sm-10">
        <textarea class="form-control" rows="20" id="sourceCode"></textarea>
    </div>
    <br/>
    <div class="col-sm-3">
        <button type="button" onclick="SubmitJudge()" class="btn btn-secondary btn-lg btn-block"><a class="display-5">提交</a></button>
    </div>
</div>


<script type="text/javascript">
    
    function SubmitJudge() {

        var code = $("#sourceCode").val();
        var data = {
            ProblemId: 1,
            SourceCode: code
        };
        
        $.post("/Home/Detail",data,function(data) {
                   
            $("#url").attr("href",data.uri);
            $("#url").html(data.uri);
            $("#title").html(data.title);
            $("#content").html(data.content);
 
        });
    }
    
</script>
