<style>
    .CodeMirror {
        border: 1px solid #eee;
        height: auto;
    }
</style>
<div class="card w-105 shadow-lg">
    <br/>
    <div class="form-group" style="margin: 15px">
        <br/>
        <div class="col-sm-10">
            <textarea class="form-control" rows="20" style="display: none;" id="sourceCode"></textarea>
        </div>
        <br/>
    </div>
    <br/>
</div>
<br/>
<hr/>
<br/>
<div id="result">

</div>
<script type="text/javascript">
 var editor = CodeMirror.fromTextArea(document.getElementById("sourceCode"),
        {
            //Java高亮显示
            //mode:"text/x-java",
            mode: "text/x-c++src",
            //mode: "text/x-python",
            //mode: "text/x-cython",
            //显示行号
            lineNumbers: true,

            //设置主题
            //theme: "idea",

            //绑定Vim
            // keyMap:"vim",

            //代码折叠
            lineWrapping: true,
            foldGutter: true,
            gutters: ["CodeMirror-linenumbers", "CodeMirror-foldgutter"],

            //全屏模式
            fullScreen: false,

            //括号匹配
            matchBrackets: true,

            matchTags: true,

            autoCloseBrackets: true,

            autoCloseTags: true,

            showTrailingSpace: true,

            showCursorWhenSelecting: true,

            //showHint:true,

            //智能提示 
            extraKeys: { "Ctrl-Space": "autocomplete" } //ctrl-space唤起智能提示
        });

    editor.setSize("100%", "500");
</script>

<script>

window.onload = function() {

        id = getQueryVariable("submitId");
        
         $.ajax({
                    type: 'get',
                    url: url + "/api/Submits/Details/" + id,
                    xhrFields: {
                        withCredentials: true
                    },
                    crossDomain: true,
                    
                    success: function(data) {
                        
                         editor.setValue(data.sourceCode);
                         
                         if(data.codeType == 0 || data.codeType == 1)
                         {
                              editor.setOption("mode", "text/x-c++src");  
                         }
                         else if(data.codeType == 2)
                         {
                              editor.setOption("mode", "text/x-python");    
                         }
                         else
                         {
                              editor.setOption("mode", "text/x-csharp");    
                         }
                     }
             });
        }
</script>