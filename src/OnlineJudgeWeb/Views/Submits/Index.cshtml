@{
    ViewData["Title"] = "Home Page";
}

<h1 class="display-4">提交列表</h1>
<br/>
<div id="submitList">
    
</div>

<nav aria-label="...">
    <ul class="pagination pagination-lg" id="pages">
    </ul>
</nav>

<script type="text/javascript">

    var totalNum = 0;
    var pageIndex = 0;
    var pageSize = 20;
    var preActive = 0;
    window.onload = function() {

        $.ajax({
            type:'get',
            url: url+"/api/Submits/pageNums",
            xhrFields: {
                withCredentials: true
            },
            crossDomain: true,
            success: function(data) {

                totalNum = data;
                getPaginationList(1); 
            }
        });

        fun(0, pageSize);

    }
    
    function getPaginationList(index)
    {
         $("#pages").empty(); 
        var html="<li class='page-item disabled' id='pre'  onclick=funPre()>";
        html += "<a class='page-link'  href='javascript:void(0)'>Previous</a>";
        html += "</li>";
       
        var pageArray = new Array(10);
        var pos=0;
        var startButton=-1;
        var endButton=-1;
        if(index<=5)
        {
            for(var i=1;i<=9;i++) 
                {
                    pageArray[pos++]=i;    
                }
            endButton = totalNum;
        }
        else if(index > 5 && index < totalNum-4)
        {
            for(var i=index-4;i<=index+4;i++)
                {
                    pageArray[pos++]=[i];
                    
                }
            startButton = 1;
            endButton = totalNum;
        }
        else
            {
                for(var i=totalNum-8;i<=totalNum;i++)
                    {
                        pageArray[pos++]=[i];
                    }
                startButton = 1;
            }
       
        if(startButton!=-1)
        {
             html += "<li class='page-item' id='page0'><a class='page-link'  href='javascript:void(0)' onclick=fun(0,"+pageSize+")>1</a></li>"; 
             html+="...";
         }
        for (var i = 0; i < pos; i++) {
            var ii = pageArray[i]-1; 
            if (ii+1 == index)
                html += "<li class='page-item active' id='page"+ii+"'><a class='page-link'  href='javascript:void(0)' onclick=fun(" +
                    ii +
                    ","+pageSize+")>" +
                    (ii + 1) +
                    "</a></li>";
            else {
                
                html += "<li class='page-item' id='page"+ii+"'><a class='page-link'  href='javascript:void(0)' onclick=fun(" +
                    ii +
                    ","+pageSize+")>" +
                    (ii + 1) +
                    "</a></li>";
                }
            }
        
        if(endButton!=-1)
            {
                html += "...";
                html += "<li class='page-item' id='page"+(totalNum-1)+"'><a class='page-link'  href='javascript:void(0)' onclick=fun("+(totalNum-1)+","+pageSize+")>"+totalNum+"</a></li>"; 
              
            }
        
        html += "<li class='page-item' id='next' onclick=funNext() >";
        html += "<a class='page-link' href='javascript:void(0)' >Next</a>";
        html += "</li>";

        $("#pages").append(html);
    }
    
    function funNext() {

        fun(pageIndex + 1, pageSize);
    }
    
    function funPre() {
        fun(pageIndex - 1, pageSize);
    }
    
    function fun(index,size) {
         getPaginationList(index); 
        var username = getCookie("userName");
        var userId = getCookie("userId");

        $("#page" + preActive).removeClass("active");
        $("#page" + index).addClass("active");
        preActive = index;
        pageIndex = index;
        pageSize = size;
        $.ajax({
            type: 'get',
            url: url+"/api/Submits/page/"+index+"/"+size,
            xhrFields: {
                withCredentials: true
            },
            crossDomain: true,
            success: function(data) {
                $("#submitList").empty();
                $.each(data,
                    function(i, term) {

                        var cla = "";
                        if (term.status == "Accept")
                            cla = "alert alert-success";
                        else
                            cla = "alert alert-danger";
                        var html = "<div class='"+cla+"' style='height:50px' id='submitId'>";
                        html += "<a href='Problems/Detail?problemId="+term.problemId+"' style='float:left'>"+"         "+term.id+".         "+term.title+"</a>";
                        if((username!=""&&username == term.userName)||userId == 1)
                             html += "<a href='Submits/Detail?submitId="+ term.id + "' style='float:right'>" + term.userName + "         " + term.status + "          </a>";
                        else
                             html += "<a style='float:right'>" + term.userName + "         " + term.status + "          </a>";
                        html += "</div>";
                       
                        $("#submitList").append(html);
                    });
                
                if (index == 0) {
                    $("#pre").removeClass("disabled");
                    $("#pre").addClass("disabled");
                }
                else if (index == totalNum - 1) {
                    $("#next").removeClass("disabled");
                    $("#next").addClass("disabled");
                } else {
                    $("#pre").removeClass("disabled");
                    $("#next").removeClass("disabled");
                }

            },
            error: function(data) {
                console.log(data);
            }
        });
        
    }

</script>