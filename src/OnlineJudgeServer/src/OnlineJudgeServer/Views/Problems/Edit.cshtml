                <span asp-validation-for="ProblemId" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Id"/>
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control"/>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AcceptSubmit" class="control-label"></label>
                <input asp-for="AcceptSubmit" class="form-control"/>
                <span asp-validation-for="AcceptSubmit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalSubmit" class="control-label"></label>
                <input asp-for="TotalSubmit" class="form-control"/>
